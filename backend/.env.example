# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://upkept:upkept@localhost:5432/upkept
REDIS_URL=redis://localhost:6379/0

# Login tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Encryption keys for ID numbers and files, as "version:base64key" pairs, newest first.
# Generate a key with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# In production, load this from a secrets manager, NOT from the same place as DATABASE_URL.
ENCRYPTION_KEYS=v1:REPLACE_WITH_BASE64_32_BYTE_KEY

# File storage. Leave the S3 lines empty to keep encrypted files on this computer
# (LOCAL_STORAGE_DIR, a Docker volume). Fill them in for Cloudflare R2 when going live.
LOCAL_STORAGE_DIR=/data/files
# Cloudflare R2 or any S3-compatible service
S3_ENDPOINT_URL=
S3_BUCKET=upkept-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# AI document reading: "rules" (free, no network, good for development) or "anthropic"
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MONTHLY_BUDGET_USD=50
FREE_PLAN_AI_SCANS_PER_MONTH=10

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Upkept <reminders@upkept.app>

# Where the guides and travel rules live (repo root /content)
CONTENT_DIR=../content

# Hour (in the user's own time zone) when reminders go out
REMINDER_SEND_HOUR=9

CORS_ORIGINS=http://localhost:3000,http://localhost:8081
