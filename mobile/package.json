    "expo": "~58.0.26",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
